{
  "name": "notification",
  "version": "1.5.6",
  "description": "Microservice for sending messages: email, sms or push. In this version only the sending of email will be available.",
  "main": "dist/server.js",
  "scripts": {
    "build": "gulp build",
    "start": "node dist/server.js",
    "start:dev": "nodemon",
    "eslint": "eslint .",
    "test": "nyc --clean --reporter=text-summary mocha test/**/*.spec.ts",
    "test:unit": "nyc --clean --all --reporter=text-summary mocha test/unit/**/*.spec.ts",
    "test:integration": "nyc --clean --all --reporter=text-summary mocha test/integration/**/*.spec.ts",
    "test:single": "mocha",
    "test:cov": "nyc --clean --all --reporter=html --reporter=text mocha test/**/*.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haniot/notification"
  },
  "bugs": {
    "url": "https://github.com/haniot/notification/issues"
  },
  "homepage": "https://github.com/haniot/notification#readme",
  "keywords": [
    "microservice",
    "notification",
    "email",
    "sms",
    "push"
  ],
  "author": "NUTES/UEPB",
  "license": "Apache-2.0",
  "nyc": {
    "include": [
      "**/*.tsx",
      "**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "test/*",
      "config/*"
    ],
    "extension": [
      ".ts",
      ".tsx"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": true
  },
  "dependencies": {
    "amqp-client-node": "github:nutes-uepb/amqp-client-node#feature/audit-fixes",
    "body-parser": "^2.4.0",
    "dotenv": "^18.0.10",
    "email-templates": "^13.0.1",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "inversify": "^6.0.3",
    "inversify-express-utils": "^6.5.0",
    "mongoose": "^7.8.13",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "query-strings-parser": "github:nutes-uepb/query-strings-parser#feature/audit-fixes",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/body-parser": "^1.19.6",
    "@types/chai": "^5.2.3",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "gulp": "^5.0.1",
    "gulp-eslint-new": "^2.6.2",
    "gulp-typescript": "^6.0.0-alpha.1",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "email-templates": {
      "nodemailer": "^10.1.4",
      "html-to-text": "^10.0.1"
    },
    "@google-cloud/firestore-api": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "mocha": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.5"
    },
    "nodemon": {
      "minimatch": "^11.0.5"
    },
    "nyc": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.5"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    }
  }
}
